{
  "name": "jmcomic-sdk",
  "version": "1.0.0",
  "description": "适用于全平台的禁漫天堂接口完全封装",
  "homepage": "https://github.com/delta-comic/jmcomic-sdk",
  "license": "MIT",
  "author": {
    "name": "wenxig",
    "email": "wenxinguo12@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/delta-comic/jmcomic-sdk.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    }
