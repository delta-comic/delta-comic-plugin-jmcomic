{
  "name": "jmcomic-sdk",
  "version": "1.0.2",
  "description": "适用于全平台的禁漫天堂接口完全封装",
  "homepage": "https://github.com/delta-comic/jmcomic-sdk",
  "license": "MIT",
  "author": {
    "name": "wenxig",
    "email": "wenxinguo12@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/delta-comic/jmcomic-sdk.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "pack:tarball": "vp pack && pnpm pack --out ./dist/jmcomic-sdk.tgz",
    "typecheck": "tsgo -p tsconfig.app.json --noEmit && tsgo -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "crypto-es": "catalog:",
    "ky": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "msw": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "sharp": "catalog:"
  },
  "dist": {
    "tarball": "./dist/jmcomic-sdk.tgz"
  },
  "readme": "./README.md"
}